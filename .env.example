# Canonical address of the live site. Used for canonical URLs, sitemap, llms.txt.
NEXT_PUBLIC_SITE_URL=https://www.unhingedgeology.com

# Leave unset on staging. Set to "true" only at cutover, when this build
# replaces the Squarespace site. Until then every page is noindex.
NEXT_PUBLIC_INDEXABLE=

# Contact form delivery (Resend). Without these the form shows "not connected yet".
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
